# Configuration for bakalari-cli.
#
# Copy this file to ~/.config/bakalari/config.toml (or to the path
# configured by BAKALARI_CONFIG) and fill in your own credentials.
# This file is tracked only as an example; the real config is ignored.

[general]
# Bakalari hostname without "https://".
school = "zssumava.bakalari.cz"

# Number of timetable lessons to display.
max_hours = 6

# Optional local cache directory. Empty = ${XDG_CACHE_HOME:-$HOME/.cache}/bakalari.
# cache_dir = "/custom/path/bakalari"

[colors]
# Optional ANSI 256-color palette for timetable subjects.
# If a subject is missing here, rozvrh.sh uses its built-in default color.
# Valid values are 0-255.
Hv  = 135
M   = 33
Čj  = 34
Prv = 172
Vv  = 44
Pč  = 160
Tv  = 170

# The section name must match the "school" value above.
[zssumava.bakalari.cz]
user  = "your_username"
pass  = "your_password"

# TOKEN is filled and refreshed automatically after login.
TOKEN = ""
